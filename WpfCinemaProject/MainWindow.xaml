<Window x:Class="WpfCinemaProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCinemaProject"
        mc:Ignorable="d"
        Title="Кинотеатр" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged" PlaceholderText="Поиск..."/>
            <ComboBox x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged" Width="150" Margin="10,0,0,0">
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>
        </StackPanel>

        <ListView x:Name="LViewMovies" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LViewMovies_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="5" Margin="5" Width="200" Height="300">
                        <StackPanel>
                            <Image Source="{Binding CoverImage}" Height="150" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="5"/>
                            <TextBlock Text="{Binding Rating, StringFormat='Рейтинг: {0}'}" Margin="5"/>
                            <TextBlock Text="{Binding StartDate, StringFormat='Дата: {0:dd.MM.yyyy}'}" Margin="5"/>
                            <TextBlock Text="{Binding AgeLimit, StringFormat='{0}+'}" Foreground="Red" HorizontalAlignment="Right" Margin="5"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Content="Личный кабинет" Grid.Row="2" Height="30" Click="BtnProfile_Click"/>
    </Grid>
</Window>
